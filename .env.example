# Copy this file to .env.local and fill in the four values to run against your real Firebase
# project instead of the emulators. They are public identifiers (the web app's config), not secrets.
# Find them in the Firebase console: Project settings, Your apps, your web app.
# Never put an API key or token here: this file is committed.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secret, read on each request by /api/steam/games (not fixed at build time). Create a
# key at https://steamcommunity.com/dev/apikey and put it in .env.local, never here. When unset,
# the route answers with an error that names STEAM_API_KEY. Leave this line empty in this file.
STEAM_API_KEY=
